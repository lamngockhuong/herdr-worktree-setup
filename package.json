{
  "name": "herdr-worktree-setup",
  "version": "0.2.0",
  "description": "Herdr plugin that prepares every new worktree: auto-detected config files, shared-directory links, and opt-in setup commands",
  "license": "MIT",
  "author": "Lam Ngoc Khuong <hi@khuong.dev>",
  "repository": "https://github.com/lamngockhuong/herdr-worktree-setup",
  "homepage": "https://github.com/lamngockhuong/herdr-worktree-setup#readme",
  "bugs": "https://github.com/lamngockhuong/herdr-worktree-setup/issues",
  "keywords": [
    "herdr",
    "herdr-plugin",
    "git-worktree",
    "dotenv",
    "monorepo"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "node --test",
    "lint": "pnpm dlx @biomejs/biome@2.5.6 check .",
    "lint:fix": "pnpm dlx @biomejs/biome@2.5.6 check --write .",
    "check": "pnpm lint && pnpm test"
  }
}
